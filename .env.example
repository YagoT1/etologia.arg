# ─────────────────────────────────────────────────────────────
# Variables de entorno — Etología Argentina
# Copiar a .env.local para desarrollo y configurar en Vercel para producción.
# El build FALLA de forma explícita si falta una variable requerida (sin fallback silencioso).
# ─────────────────────────────────────────────────────────────

# Sanity (requerido)
NEXT_PUBLIC_SANITY_PROJECT_ID=a1bhfmpi
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# WhatsApp de contacto (requerido) — número internacional, sólo dígitos.
# Ej. Argentina: 549 + característica sin 0 + número sin 15.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493511234567

# URL canónica del sitio (opcional; por defecto usa la del código).
NEXT_PUBLIC_SITE_URL=https://etologia-arg.vercel.app

# ─────────────────────────────────────────────────────────────
# NOTA TLS (máquinas detrás de antivirus/proxy que inspeccionan HTTPS)
# Si `npm run build` falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE al consultar Sanity,
# NO usar NODE_TLS_REJECT_UNAUTHORIZED=0. Ver TROUBLESHOOTING.md.
# Estas variables van a nivel de SISTEMA OPERATIVO (no en .env.local, porque Node las
# lee ANTES de cargar dotenv):
#   Windows (permanente):  setx NODE_OPTIONS "--use-system-ca"
#   o bien:                setx NODE_EXTRA_CA_CERTS "C:\ruta\rootCA.pem"
# ─────────────────────────────────────────────────────────────
