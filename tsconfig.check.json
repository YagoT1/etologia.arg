{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false, "skipLibCheck": true },
  "include": [
    "app/(site)/page.tsx",
    "app/(site)/layout.tsx",
    "app/(site)/about/page.tsx",
    "app/(site)/contact/page.tsx",
    "app/(site)/en/page.tsx",
    "app/(site)/error.tsx",
    "app/(site)/not-found.tsx",
    "app/(site)/blog/loading.tsx",
    "app/(site)/blog/[slug]/loading.tsx",
    "app/not-found.tsx",
    "app/global-error.tsx",
    "app/layout.tsx",
    "app/robots.ts",
    "app/opengraph-image.tsx",
    "app/twitter-image.tsx",
    "app/studio/layout.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/og-image.tsx",
    "config/**/*.ts",
    "types/**/*.ts",
    "sanity/env.ts",
    "sanity/lib.image.ts",
    "hooks/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
